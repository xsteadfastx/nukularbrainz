# direnv
/.direnv/

# nix build results
/result
/result-*

# generated by pre-commit-nix
/.pre-commit-config.yaml

# downloaded episode cover art (keep the dir, ignore the images)
/cover-art/*
!/cover-art/.gitkeep

# downloaded episode audio (keep the dir, ignore the files)
/episodes/*
!/episodes/.gitkeep
/.playwright-mcp/
